# All optional — everything degrades gracefully without them.
SEMANTIC_SCHOLAR_API_KEY=
OPENCITATIONS_API_TOKEN=
KCI_API_KEY=
# OpenAlex — free key ($1/day credit, ~1,000 searches). Works keyless at $0.10/day.
OPENALEX_API_KEY=
# LLM CLI command template for rerank/synthesis (reads prompt from stdin).
# Examples:
#   PAPER_SCOUT_LLM_CMD=claude -p
#   PAPER_SCOUT_LLM_CMD=codex exec --sandbox read-only --skip-git-repo-check -
PAPER_SCOUT_LLM_CMD=
PAPER_SCOUT_OUTPUT_DIR=
